---
import SiteLayout from "../layout/siteLayout.astro";
import MainHeroSection from "../container/main-hero.astro";
import GatewaySolution from "../container/gateway-solution.astro";
import Customers from "../container/customers.astro";
import Sense from "../container/sense.astro";
import BrandCarousel from "../container/BrandCarousel.astro";
import { useTranslations } from "@/i18n/utils";
const locale = Astro.currentLocale || 'root';
const t = useTranslations(locale);
const metaDescription = t('home.description');
const metaImage = 'https://higress.ai/img/higress-ai-gateway-og.png';
---
<SiteLayout title={t("home.title")} description={metaDescription}>
    <MainHeroSection />
    <div class="flex flex-col gap-10 md:gap-20 lg:gap-30">
      <GatewaySolution />
      <Sense />
      <Customers />
      <BrandCarousel />
    </div>
</SiteLayout>

<!-- Structured Data for SEO -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Higress",
  "url": "https://higress.ai",
  "logo": "https://higress.ai/img/higress-mark.png",
  "image": metaImage,
  "description": metaDescription,
  "sameAs": [
    "https://github.com/alibaba/higress",
    "https://www.cncf.io/projects/higress/"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "technical support",
    "url": "https://higress.ai"
  }
})} />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Higress",
  "url": "https://higress.ai",
  "description": metaDescription,
  "image": metaImage,
  "inLanguage": "zh-CN"
})} />
